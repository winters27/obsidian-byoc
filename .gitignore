# Intellij
*.iml
.idea

# npm
node_modules
# package-lock.json is committed on purpose: CI installs with `npm ci` so the
# dependency tree is reproducible. Without it npm resolves a fresh tree on every
# run, which silently drifts with the registry and broke the 1.0.14 release.
pnpm-lock.yaml

# build
main.js
*.js.map

# obsidian
data.json

# debug
logs.txt

# hidden files
.*
!.gitignore
!.github/

# env
.env
tests_coverage/

# Project Management & Artifacts
upstream_tracker.md
upstream_issues.md
issues*.json

# Lint output snapshots and one-shot fix scripts (local-only)
lint-bot*.json
lint-report.json
sentence-case-fixes.json
temp-fix-script*.js

# Ignore internal docs/markdown
**/*.md
!README.md
!CONTRIBUTING.md

# Ignore log and debug artifacts
*.log
*.txtx
*.txt
!tests/static_assets/**/*.txt
